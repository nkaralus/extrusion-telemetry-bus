#!/usr/bin/env python3
"""cascade_clock.py - Project Cascade, Step 4: the 4-slot harness clock.

  python3 cascade_clock.py BLOCK.json                    run one frame with the real mule (Gemma through bench.py)
  python3 cascade_clock.py BLOCK.json --script R.json    rehearsal: the mule's answers come from R.json (a JSON list of strings), no GPU

One frame = one task block (task_block_spec.json format), one pass through four slots:
  SLOT_1 FETCH    look up the block's address in state_registry.json            + GI_1 (address, uid, conflicts, block shape)
  SLOT_2 ROUTE    load the op definition                                        + GI_2 (VRAM and RAM-cache limits)
  SLOT_3 EXECUTE  the mule sees ONLY json: the task block and its one RAG record + GI_3 (reply shape, value, exclude list)
  SLOT_4 JUDGE    the statement is wrapped in a throwaway script and checked with godot --headless --check-only
ACK  -> one row in ledger.jsonl.   NAK -> Godot's exact error goes back into the next block, up to 3 tries.
3 NAKs -> dead_letter/<frame_id>.json.
An ACK is then written into the owner scene as ONE line (backup .bak first, headless reload check after, rollback if the value did not take).
--no-apply skips that write.
Exit codes: 0 ACK or APPLIED, 2 rejected before the mule, 3 dead letter, 4 ACK but not applied or rolled back, 1 stopped (missing file, model error, no Godot).
"""
import argparse, collections, json, os, re, shutil, subprocess, sys, tempfile, time

def now(): return time.strftime("%Y-%m-%dT%H:%M:%S")
def log(msg): print(msg, flush=True)
def die(msg): sys.exit("STOPPED: " + msg)
def strip_ansi(s): return re.sub(r"\x1b\[[0-9;]*m", "", s)

def load(path):
    if not os.path.exists(path):
        die(f"missing {path}")
    return json.load(open(path, encoding="utf-8"))

def header_uid(project, res_path):
    fp = os.path.join(project, res_path[len("res://"):])
    if not os.path.exists(fp):
        return None
    m = re.search(r'^\[gd_scene[^\]]*\suid="(uid://[a-z0-9]+)"', open(fp, encoding="utf-8").read(), re.M)
    return m.group(1) if m else None

NUM = r"[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?"

def value_ok(t, v):
    num = lambda x: isinstance(x, (int, float)) and not isinstance(x, bool)
    if t == "bool": return isinstance(v, bool)
    if t == "int": return isinstance(v, int) and not isinstance(v, bool)
    if t == "float": return num(v)
    if t == "String": return isinstance(v, str)
    if t in ("Vector2", "Vector3", "Color"):
        n = {"Vector2": (2,), "Vector3": (3,), "Color": (3, 4)}[t]
        return isinstance(v, list) and len(v) in n and all(num(x) for x in v)
    return False

# ---------------------------------------------------------------- SLOT 1 + GI_1
def slot1(block, reg, spec, project):
    s, bad = spec["slots"], []
    if block.get("op") in CLOCK_OPS and spec["ops"].get(block["op"], {}).get("status") != "locked":
        return None, [f"the spec is behind the clock: it has no locked '{block['op']}' op. Run: python3 patch_status.py"]
    want = spec["ops"].get(block.get("op"), {}).get("slots") or list(s)
    for k in want:
        if k not in block: bad.append(f"block.{k} is missing")
    optional = spec["ops"].get(block.get("op"), {}).get("optional_slots", [])
    bad += [f"block.{k} is not a slot of op {block.get('op')}" for k in block if k not in want and k not in optional]
    if bad: return None, bad
    for k in ("frame_id", "subnet", "target", "ref"):
        if not re.match(s[k]["rx"], str(block[k])): bad.append(f"block.{k} '{block[k]}' does not match the spec")
    if block["time_slot"] not in s["time_slot"]["enum"]: bad.append(f"block.time_slot '{block['time_slot']}' not allowed")
    if block["op"] not in s["op"]["enum"]: bad.append(f"block.op '{block['op']}' not allowed")
    elif spec["ops"].get(block["op"], {}).get("status") != "locked": bad.append(f"op {block['op']} is open: its slots are not defined yet")
    if block["op"] == "modify_property" and block["type"] not in s["type"]["enum"]: bad.append(f"block.type '{block['type']}' not allowed")
    if not isinstance(block["exclude"], list) or not block["exclude"] or any(e not in s["exclude"]["enum"] for e in block["exclude"]):
        bad.append("block.exclude must be a non-empty list of names from the spec")
    host = reg.get("hosts", {}).get(block["ref"])
    if host is None:
        return None, bad + [f"GI_1 addr_in_registry: {block['ref']} is not in the registry"]
    if not re.match(r"^uid://[a-z0-9]+$", host.get("uid", "")): bad.append("GI_1 uid_in_registry: host has no valid uid")
    else:
        cur = header_uid(project, host["scene"])
        if cur != host["uid"]:
            bad.append(f"GI_1 uid_in_registry: registry is stale ({host['scene']} has {cur}, registry has {host['uid']}); run registry_builder.py")
    if "script" not in host: bad.append("GI_1 registry has no 'script' field; update and re-run registry_builder.py")
    if block["subnet"] != host["subnet"]: bad.append(f"GI_1 subnet_boundary: block subnet {block['subnet']} but {block['ref']} is in {host['subnet']}")
    if block["target"] != host["name"]: bad.append(f"GI_1 addr_in_registry: {block['ref']} is {host['name']}, block says {block['target']}")
    if block["op"] == "connect_signal": bad += connect_checks(block, host, spec, project)
    elif block["op"] == "add_method": bad += add_method_checks(block, host, spec, project)
    elif block["property"] not in host["props"]: bad.append(f"block.property '{block['property']}' is not in the record's props")
    elif block["type"] != host["props"][block["property"]]: bad.append(f"block.type {block['type']} but the record says {block['property']} is {host['props'][block['property']]}")
    elif not value_ok(block["type"], block["value"]): bad.append(f"block.value {block['value']} is not a valid {block['type']}")
    base = host["subnet"].split("/")[0].rsplit(".", 1)[0]
    seen = {}
    for a, h in reg["hosts"].items():
        if not a.startswith(base + ".") and h["subnet"] == host["subnet"]: bad.append(f"GI_1 no_addr_conflict: {a} is outside {host['subnet']}")
        if h["subnet"] == host["subnet"]:
            if h["name"] in seen: bad.append(f"GI_1 no_addr_conflict: name {h['name']} at {seen[h['name']]} and {a}")
            seen[h["name"]] = a
    return host, bad

# ---------------------------------------------------------------- SLOT 2 + GI_2
def gi2(spec, mule_dir, model, skip_vram=False):
    lim = spec["guards"]["GI_2"]; vram = ram = None
    cfg = os.path.join(mule_dir, "config.json")
    if os.path.exists(cfg):
        ram = json.load(open(cfg)).get("models", {}).get(model, {}).get("clip", {}).get("ram_cache")
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=memory.used", "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=15)
        if r.returncode == 0: vram = float(r.stdout.strip().splitlines()[0]) / 1024
    except (FileNotFoundError, ValueError, subprocess.TimeoutExpired):
        pass
    if skip_vram: vram = None                       # the model is already loaded in this process: its own memory sits near the limit
    bad = []
    if vram is not None and vram > lim["vram_gb_max"]: bad.append(f"GI_2 vram: {vram:.1f} GB in use, limit {lim['vram_gb_max']}")
    if ram is not None and float(ram) > lim["ram_cache_gb_max"]: bad.append(f"GI_2 ram_cache: {ram} GB in config, limit {lim['ram_cache_gb_max']}")
    return bad, {"vram_gb_used": None if vram is None else round(vram, 2), "ram_cache_gb": ram, **({"vram_check": "skipped, model already loaded in this process"} if skip_vram else {})}

# ---------------------------------------------------------------- SLOT 3 + GI_3
EXAMPLE_VALUES = {"Vector2": [[120.0, -35.5], [60.0, 10.0]], "Vector3": [[1.5, 0.0, -2.0], [3.0, 1.0, 0.5]],
                  "Color": [[0.2, 0.4, 0.6, 1.0], [0.9, 0.1, 0.3, 1.0]], "bool": [True, False], "int": [7, 3],
                  "float": [250.0, 125.0], "String": ["idle", "walk"]}

def worked_example(block, host, spec):
    """One completed reference frame: same shape as the task, a different value. None if no valid example can be made."""
    if block.get("op") != "modify_property": return None
    t = block["type"]
    if t not in EXAMPLE_VALUES: return None
    val = next((v for v in EXAMPLE_VALUES[t] if v != block["value"]), None)
    prop = next((k for k, pt in host["props"].items() if pt == t and k != block["property"]), block["property"])
    ex = dict(block, frame_id="0x0000", property=prop, type=t, value=val)
    reply = {"frame_id": "0x0000", "target": block["target"], "stmt": f"{prop} = {scene_literal(t, val)}"}
    if not value_ok(t, val) or gi3(reply, ex, spec) is not None: return None
    return {"task": ex, "reply": reply}

# What the MULE gets to read. The guards still check the full block and the full RAG record; only this view is slimmed.
SLIM_VIEW = {"modify_property": {"task": ["frame_id", "op", "target", "property", "type", "value"], "rag": ["node", "name"]},
             "connect_signal": {"task": ["frame_id", "op", "target", "signal", "method"], "rag": ["node", "name"]},
             "add_method": {"task": ["frame_id", "op", "target", "fn", "args", "body", "message", "property", "type", "value", "operator"], "rag": ["node", "name"]}}

def mule_view(block, host, slim):
    view = SLIM_VIEW.get(block["op"]) if slim else None
    if not view:
        return block, {k: host[k] for k in ("addr", "subnet", "uid", "node", "name", "props", "peering", "exclude")}
    rag = {k: host[k] for k in view["rag"]}
    if "property" in block: rag["props"] = {block["property"]: host["props"][block["property"]]}
    return {k: block[k] for k in view["task"] if k in block}, rag

# Ultra-slim: the task fields only. The prefill already carries frame_id, target, property and the constructor.
ULTRA_VIEW = {"modify_property": ["op", "property", "type", "value"], "connect_signal": ["op", "signal", "method"], "add_method": ["op", "fn", "body", "message", "property", "type", "value", "operator"]}

def mule_message(block, host, prev, example=None, slim=False, ultra=False):
    if ultra and block["op"] in ULTRA_VIEW:
        msg = {"task": {k: block[k] for k in ULTRA_VIEW[block["op"]] if k in block}}
        if prev: msg["nak"] = prev
        return json.dumps(msg, separators=(",", ":"))
    task, rag = mule_view(block, host, slim)
    msg = {}
    if example: msg["example"] = example
    msg.update({"task": task, "rag": rag, "reply": {"frame_id": block["frame_id"], "target": block["target"], "stmt": ""}})
    if prev: msg["nak"] = prev
    return json.dumps(msg, separators=(",", ":"))

def parse_reply(text):
    dec = json.JSONDecoder()
    for i, ch in enumerate(text):
        if ch == "{":
            try: obj, _ = dec.raw_decode(text[i:])
            except ValueError: continue
            if isinstance(obj, dict) and "stmt" in obj: return obj
    return None

def expr_error(t, expr, value):
    if t in ("Vector2", "Vector3", "Color"):
        m = re.match(rf"^{t}\(\s*({NUM}(?:\s*,\s*{NUM})*)\s*\)$", expr)
        if not m: return f"write the value as {t}(...) with number literals only"
        got, want = [float(x) for x in re.split(r"\s*,\s*", m.group(1))], [float(x) for x in value]
        if t == "Color":
            got += [1.0] * (4 - len(got)); want += [1.0] * (4 - len(want))
        if len(got) != len(want) or any(abs(a - b) > 1e-9 for a, b in zip(got, want)): return f"value must equal {want}, got {got}"
        return None
    if t == "bool": return None if expr == ("true" if value else "false") else f"value must be {'true' if value else 'false'}"
    if t == "int": return None if re.match(r"^[-+]?\d+$", expr) and int(expr) == value else f"value must be the integer {value}"
    if t == "float": return None if re.match(rf"^{NUM}$", expr) and float(expr) == float(value) else f"value must be the number {value}"
    if t == "String": return None if expr == json.dumps(value, ensure_ascii=False) else f"value must be the string {json.dumps(value)}"
    return f"type {t} not supported"

def gi3(reply, block, spec):
    if reply is None: return "json_parse: no JSON object with a 'stmt' key in the answer"
    if reply.get("frame_id") != block["frame_id"] or reply.get("target") != block["target"]:
        return "slot_enum_match: frame_id and target must echo the block"
    stmt = reply.get("stmt")
    if not isinstance(stmt, str) or not stmt.strip(): return "slot_enum_match: stmt must be a non-empty string"
    stmt = stmt.strip()
    if "\n" in stmt and block["op"] != "add_method": return "slot_enum_match: stmt must be exactly one line"
    if block["op"] == "connect_signal":
        want = f"{block['signal']}.connect({block['method']})"
        if stmt not in (want, f"{block['signal']}.connect(self.{block['method']})"): return f"type_match: stmt must be {want} (self. before the method is also accepted)"
    elif block["op"] == "add_method":
        err = add_method_stmt_error(stmt, block)
        if err: return err
    else:
        m = re.match(rf"^{re.escape(block['property'])}\s*=\s*(.+)$", stmt)
        if not m: return f"type_match: stmt must be one assignment to {block['property']}"
        err = expr_error(block["type"], m.group(1).strip(), block["value"])
        if err: return "type_match: " + err
    for name in block["exclude"]:
        chk = spec["exclude_checks"][name]
        if chk["kind"] == "regex" and re.search(chk["rx"], stmt): return f"exclude_hit: {name}"
        if chk["kind"] == "code" and re.search(r"\b\d{1,3}(?:\.\d{1,3}){3}\b", stmt): return f"exclude_hit: {name} (no addresses inside a statement)"
    return None

# ---------------------------------------------------------------- SLOT 4
def canonical_stmt(stmt, block):
    """The statement Godot is asked to judge. For connect_signal that is the bare form: the parse check reports a missing method there, but not behind self."""
    if block["op"] == "connect_signal": return f"{block['signal']}.connect({block['method']})"
    return stmt

def judge(godot, project, host, stmt):
    tmp = tempfile.mkdtemp(prefix="cascade_judge_")
    path = os.path.join(tmp, "frame.gd")
    base = f'"{host["script"]}"' if host.get("script") else host["node"]
    open(path, "w").write(f"extends {base}\n\nfunc cascade_frame() -> void:\n    {stmt}\n")
    try:
        r = subprocess.run([godot, "--headless", "--path", project, "--check-only", "--script", path], capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        die(f"Godot not found as '{godot}'. Use --godot /path/to/godot or: export GODOT=/path/to/godot")
    except subprocess.TimeoutExpired:
        return False, "judge timeout (60 s)"
    if r.returncode == 0: return True, ""
    lines = strip_ansi(r.stdout + r.stderr).splitlines(); errs = []
    for i, l in enumerate(lines):
        if l.startswith("SCRIPT ERROR:"):
            at = lines[i + 1].strip() if i + 1 < len(lines) and lines[i + 1].strip().startswith("at:") else ""
            errs.append((l[len("SCRIPT ERROR:"):].strip() + " " + at.replace(path, "frame.gd")).strip())
    return False, " | ".join(errs[:3]) or "\n".join(lines[-4:])

# ---------------------------------------------------------------- APPLY (Step 5): one-line edit of the owner scene
class ApplyError(Exception):
    pass

RELOAD_HELPER = r"""extends SceneTree

func _init() -> void:
    var a: PackedStringArray = OS.get_cmdline_user_args()
    var res := {"found": false}
    var packed: PackedScene = load(a[1])
    if packed != null:
        var root: Node = packed.instantiate()
        var n: Node = root.get_node_or_null("%" + a[2])
        if n != null:
            res["found"] = true
            var v: Variant = n.get(a[3])
            match typeof(v):
                TYPE_VECTOR2:
                    res["value"] = [v.x, v.y]
                TYPE_VECTOR3:
                    res["value"] = [v.x, v.y, v.z]
                TYPE_COLOR:
                    res["value"] = [v.r, v.g, v.b, v.a]
                _:
                    res["value"] = v
        root.free()
    var f := FileAccess.open(a[0], FileAccess.WRITE)
    f.store_string(JSON.stringify(res))
    f.close()
    quit()
"""

def fnum(x): return repr(float(x))

def scene_literal(t, v):
    if t == "bool": return "true" if v else "false"
    if t == "int": return str(int(v))
    if t == "float": return fnum(v)
    if t == "String": return json.dumps(v, ensure_ascii=False)
    if t == "Color" and len(v) == 3: v = list(v) + [1.0]
    return f"{t}(" + ", ".join(fnum(x) for x in v) + ")"

def find_node_block(lines, name, parent):
    hits = [i for i, l in enumerate(lines)
            if l.startswith("[node ") and re.search(r'\bname="' + re.escape(name) + '"', l) and re.search(r'\bparent="' + re.escape(parent) + '"', l)]
    if len(hits) != 1:
        raise ApplyError(f"found {len(hits)} node sections for {name} with parent '{parent}' (expected exactly 1)")
    end = next((j for j in range(hits[0] + 1, len(lines)) if lines[j].startswith("[")), len(lines))
    return hits[0], end

def edit_scene_text(raw, tree, prop, literal):
    """returns (new_text, action, line_number, before). Pure text edit, nothing is written here."""
    nl = "\r\n" if "\r\n" in raw else "\n"
    lines = raw.split(nl)
    rel = tree.split("/", 1)[1] if "/" in tree else ""
    if not rel: raise ApplyError(f"tree '{tree}' has no node below the scene root")
    name = rel.split("/")[-1]; parent = "." if "/" not in rel else rel.rsplit("/", 1)[0]
    start, end = find_node_block(lines, name, parent)
    new_line = f"{prop} = {literal}"
    for k in range(start + 1, end):
        if re.match(rf"^{re.escape(prop)}\s*=", lines[k]):
            v = lines[k].split("=", 1)[1]
            if v.count("(") != v.count(")") or v.count("[") != v.count("]") or v.count("{") != v.count("}") or v.count('"') % 2:
                raise ApplyError(f"{prop} is written over several lines in the scene; not editing it automatically")
            before = lines[k]; lines[k] = new_line
            return nl.join(lines), "replaced", k + 1, before
    last = max(j for j in range(start, end) if lines[j].strip())
    lines.insert(last + 1, new_line)
    return nl.join(lines), "inserted", last + 2, None

def reload_check(godot, project, host, block):
    tmp = tempfile.mkdtemp(prefix="cascade_reload_")
    helper, out = os.path.join(tmp, "reload.gd"), os.path.join(tmp, "out.json")
    open(helper, "w").write(RELOAD_HELPER)
    try:
        r = subprocess.run([godot, "--headless", "--path", project, "--script", helper, "--", out, host["owner_scene"], host["name"].lstrip("%"), block["property"]],
                           capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        die(f"Godot not found as '{godot}'. Use --godot /path/to/godot or: export GODOT=/path/to/godot")
    except subprocess.TimeoutExpired:
        return False, None, "reload timeout (60 s)"
    if not os.path.exists(out): return False, None, "Godot could not reload the scene:\n" + strip_ansi(r.stdout + r.stderr)[-400:]
    res = json.load(open(out))
    if not res.get("found"): return False, None, f"{host['name']} was not found in {host['owner_scene']} after the edit"
    got, want, t = res["value"], block["value"], block["type"]
    if t in ("Vector2", "Vector3", "Color"):
        got, want = [float(x) for x in got], [float(x) for x in want]
        if t == "Color": want += [1.0] * (4 - len(want))
        same = len(got) == len(want) and all(abs(a - b) < 1e-6 for a, b in zip(got, want))
    elif t in ("float", "int"): same = abs(float(got) - float(want)) < 1e-6
    else: same = got == want
    return same, res["value"], "" if same else f"reloaded value {res['value']} does not equal {block['value']}"

def apply_scene_property(godot, project, host, block):
    """Edit one line of the owner scene, with a .bak backup first and a headless reload check after. Rolls back if the check fails."""
    fp = os.path.join(project, host["owner_scene"][len("res://"):])
    if not os.path.exists(fp): raise ApplyError(f"{host['owner_scene']} not found")
    raw = open(fp, "rb").read().decode("utf-8")
    new_text, action, line_no, before = edit_scene_text(raw, host["tree"], block["property"], scene_literal(block["type"], block["value"]))
    bak = f"{fp}.{block['frame_id']}.{time.strftime('%Y%m%d-%H%M%S')}.bak"
    shutil.copy2(fp, bak)
    tmp = fp + ".cascade_tmp"
    open(tmp, "wb").write(new_text.encode("utf-8")); os.replace(tmp, fp)
    ok, got, msg = reload_check(godot, project, host, block)
    result = {"file": host["owner_scene"], "backup": bak, "action": action, "line": line_no, "before": before,
              "after": f"{block['property']} = {scene_literal(block['type'], block['value'])}", "reloaded_value": got, "verified": ok}
    if not ok:
        shutil.copy2(bak, fp); result["rolled_back"] = True; result["problem"] = msg
    return result

# ---------------------------------------------------------------- prefill: start the mule's answer for it
def complete_prefilled(prefill, cont):
    """The mule continues after the prefill; close the JSON string at its first unescaped quote (anything after is ignored)."""
    m = re.search(r'(?<!\\)"', cont)
    return prefill + (cont[:m.start()] if m else cont.strip()) + '"}'

def ask_prefilled(bench, model_key, message, prefill, max_new=120, on_prompt_done=None):
    """Same model and sampling as bench.ask, but the answer already starts with `prefill`. Returns only the continuation."""
    import torch
    bench._load(model_key)
    tok, model = bench._loaded["tok"], bench._loaded["model"]
    text = tok.apply_chat_template([{"role": "user", "content": message}], add_generation_prompt=True, tokenize=False) + prefill
    enc = tok(text, return_tensors="pt", add_special_tokens=False).to(model.device)
    t0 = time.time()
    extra = {}
    if on_prompt_done:
        from transformers import LogitsProcessor, LogitsProcessorList
        class _Mark(LogitsProcessor):
            fired = False
            def __call__(self, input_ids, scores):
                if not _Mark.fired:
                    _Mark.fired = True; on_prompt_done(input_ids.shape[-1] if hasattr(input_ids, "shape") else None)
                return scores
        extra["logits_processor"] = LogitsProcessorList([_Mark()])
    with torch.no_grad():
        out = model.generate(**enc, max_new_tokens=max_new, do_sample=bench.CFG["temperature"] > 0,
                             temperature=max(bench.CFG["temperature"], 1e-5), **extra)
    dt = time.time() - t0
    new = out[0][enc["input_ids"].shape[-1]:]
    return tok.decode(new, skip_special_tokens=True), int(new.shape[-1]), dt

# ---------------------------------------------------------------- AMMO CLIP recorder (Step 6): cache metrics + per-tool heat map
class Recorder:
    """Hooks the clip. Splits every frame into PROMPT and DECODE, reports cache hits and SSD wait for each, and - only for an
    answer Godot ACKs - adds the experts picked to results/heatmap_<model>_tool_<op>.json in the mule folder."""
    def __init__(self, clip, path, tag, source, record):
        self.clip, self.path, self.tag, self.source, self.record = clip, path, tag, source, record
        self.keep_flag = getattr(clip, "HEAT_DECODE_ONLY", None)
        self.pre_heat = self.all_heat = self.dec_heat = self.s0 = self.s1 = self.prompt_tokens = None

    def _snap(self):
        st = self.clip.STORE
        return {"stats": dict(st.stats), "ssd": float(st.ssd_seconds), "t": time.time()}

    @staticmethod
    def _phase(a, b):
        d = {k: b["stats"].get(k, 0) - a["stats"].get(k, 0) for k in ("vram", "ram", "prefetch_hit", "ssd")}
        d["picks"] = sum(d.values()); d["ssd_wait_s"] = round(b["ssd"] - a["ssd"], 2); d["seconds"] = round(b["t"] - a["t"], 2)
        return d

    def begin(self):
        self.clip.HEAT_DECODE_ONLY = False           # count the prompt too; the split happens in mark()
        self.clip.STORE.heat.clear(); self.pre_heat = None; self.s1 = None; self.s0 = self._snap()

    def mark(self, n_tokens=None):                   # called by the generate hook the moment the prompt is done
        self.pre_heat = collections.Counter(self.clip.STORE.heat); self.s1 = self._snap(); self.prompt_tokens = n_tokens

    def end(self):
        s2 = self._snap(); self.all_heat = collections.Counter(self.clip.STORE.heat)
        if self.keep_flag is not None: self.clip.HEAT_DECODE_ONLY = self.keep_flag
        out = {"source": self.source, "split": self.s1 is not None, "unique_experts": len(self.all_heat), "total": self._phase(self.s0, s2)}
        self.dec_heat = None
        if self.s1 is not None:
            self.dec_heat = self.all_heat - self.pre_heat
            out["prompt"] = self._phase(self.s0, self.s1); out["decode"] = self._phase(self.s1, s2)
            out["unique_prompt"] = len(self.pre_heat); out["unique_decode"] = len(self.dec_heat); out["prompt_tokens"] = self.prompt_tokens
        return out

    def line(self, m):
        def f(d):
            n = max(d["picks"], 1)
            return f"{d['seconds']:.1f}s, SSD wait {d['ssd_wait_s']:.1f}s, VRAM {d['vram']/n:.0%} RAM {d['ram']/n:.0%} prefetch {d['prefetch_hit']/n:.0%} SSD {d['ssd']/n:.0%}"
        if m["split"]: return f"prompt ({m.get('prompt_tokens', '?')} tokens) {f(m['prompt'])}  |  decode {f(m['decode'])}  |  experts touched {m['unique_experts']}"
        return f"whole frame {f(m['total'])}  |  experts touched {m['unique_experts']}"

    def commit(self):
        """Merge this attempt's picks into the tool's cumulative map. Called only after Godot said ACK."""
        if not self.record: return False
        old = json.load(open(self.path)) if os.path.exists(self.path) else {}
        def merge(key, add):
            cum = collections.Counter({(l, e): c for l, e, c in old.get(key, [])}); cum.update(add or {})
            return [[l, e, c] for (l, e), c in cum.most_common()]
        data = {"tag": self.tag, "runs": old.get("runs", 0) + 1, "last_prompt": "cascade_clock", "picks": merge("picks", self.all_heat)}
        for key, add in (("prompt_picks", self.pre_heat), ("decode_picks", self.dec_heat)):
            if add is not None: data[key] = merge(key, add)
            elif key in old: data[key] = old[key]
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        tmp = self.path + ".tmp"; json.dump(data, open(tmp, "w")); os.replace(tmp, self.path)
        return True

def make_recorder(bench, a, block, mule_dir):
    mcfg = bench.CFG["models"].get(a.model) or {}
    clipcfg = mcfg.get("clip")
    if not clipcfg: return None
    tag = f"tool_{block['op']}"
    path = os.path.join(mule_dir, "results", f"heatmap_{os.path.basename(os.path.normpath(mcfg['path']))}_{tag}.json")
    first_load = bench._loaded.get("key") != a.model
    use_map = first_load and not a.no_toolmap and os.path.exists(path)
    if use_map: clipcfg["warm"] = False              # in memory only (config.json is not touched): do not pin the old map as well
    try: bench._load(a.model)                        # the model loads here, so frame timings exclude it
    except ModuleNotFoundError as e: die(f"the python module '{e.name}' is missing for the python running this. Run the real mule with ~/mule_bench/.venv/bin/python")
    clip = sys.modules["clip_loader"]
    if first_load:
        source = "config" if clipcfg.get("warm", True) else "none"
        if use_map:
            ranked = [(l, e) for l, e, c in json.load(open(path))["picks"]]
            clip.STORE.warm(ranked, clipcfg.get("pin_frac", 0.8))
            source = f"tool map ({len(ranked)} experts)"
        bench._cascade_source = source
    return Recorder(clip, path, tag, getattr(bench, "_cascade_source", "config"), not a.no_record)

# ---------------------------------------------------------------- connect_signal (Step 7): one [connection] line in the owner scene
def snake(name): return re.sub(r"[^a-z0-9]+", "_", name.lstrip("%").lower()).strip("_")

def op_fields(block):
    if block["op"] == "connect_signal": return {"source": block["source"], "target": block["target"], "signal": block["signal"], "method": block["method"]}
    if block["op"] == "add_method": return {"fn": block["fn"], "args": block["args"], "body": block["body"], "message": block["message"], **{k: block[k] for k in ("property", "type", "value", "operator") if k in block}}
    return {"property": block["property"], "type": block["type"], "value": block["value"]}

def node_rel(host): return host["tree"].split("/", 1)[1] if "/" in host["tree"] else ""

def connection_line(block, host):
    rel = node_rel(host)
    return f'[connection signal="{block["signal"]}" from="{rel}" to="{rel}" method="{block["method"]}"]'

def connect_checks(block, host, spec, project):
    bad = []
    for k in ("source", "signal", "method"):
        if not re.match(spec["slots"][k]["rx"], str(block[k])): bad.append(f"block.{k} '{block[k]}' does not match the spec")
    if block["source"] != host["name"]: bad.append(f"GI_1 addr_in_registry: {block['ref']} is {host['name']}, block says source {block['source']}")
    if block["source"] != block["target"]: bad.append("GI_1 connect_scope: v1 connects a node to its own method, so source must equal target (other pairs are an open slot)")
    for k in ("signals", "methods"):
        if k not in host: bad.append(f"GI_1 registry has no '{k}' field; update and re-run registry_builder.py")
    if bad: return bad
    if block["signal"] not in host["signals"]:
        bad.append(f"GI_1 signal: '{block['signal']}' is not a signal of {host['name']} ({host['node']}); it has {len(host['signals'])}, e.g. {', '.join(host['signals'][:6])}")
    if block["method"] not in host["methods"]:
        bad.append(f"GI_1 method: '{block['method']}' is not defined in {host.get('script') or 'the node'}; add it first (defined: {', '.join(host['methods']) or 'none'})")
    want = f"_on_{snake(block['target'])}_{block['signal']}"
    if block["method"] != want: bad.append(f"GI_1 method_name: the method must be {want} (the _on_<node>_<signal> convention)")
    sa, ma = host.get("signal_args"), host.get("method_args")
    if sa is None or ma is None: bad.append("GI_1 registry has no 'signal_args'/'method_args'; update and re-run registry_builder.py")
    elif block["signal"] in sa and block["method"] in ma and len(sa[block["signal"]]) != ma[block["method"]]:
        bad.append(f"GI_1 arity: {block['signal']} carries {len(sa[block['signal']])} argument(s) but {block['method']}() takes {ma[block['method']]}; Godot only reports this when the signal fires")
    return bad

def connection_exists(project, host, block):
    fp = os.path.join(project, host["owner_scene"][len("res://"):])
    if not os.path.exists(fp): return False
    rel = node_rel(host); want = {"signal": block["signal"], "from": rel, "to": rel, "method": block["method"]}
    for l in open(fp, encoding="utf-8").read().splitlines():
        if l.startswith("[connection "):
            at = dict(re.findall(r'(\w+)="([^"]*)"', l))
            if all(at.get(k) == v for k, v in want.items()): return True
    return False

def edit_scene_connection(raw, line):
    """Pure text edit: returns (new_text, action, line_number). Connections sit after the nodes and before any [editable] sections."""
    nl = "\r\n" if "\r\n" in raw else "\n"
    lines = raw.split(nl)
    if any(l.strip() == line for l in lines): raise ApplyError("this connection is already in the scene")
    conn = [i for i, l in enumerate(lines) if l.startswith("[connection ")]
    if conn:
        at = conn[-1] + 1; lines.insert(at, line); return nl.join(lines), "inserted", at + 1
    edit = [i for i, l in enumerate(lines) if l.startswith("[editable ")]
    if edit:
        at = edit[0]; lines[at:at] = [line, ""]; return nl.join(lines), "inserted", at + 1
    last = max(i for i, l in enumerate(lines) if l.strip())
    lines[last + 1:last + 1] = ["", line]
    return nl.join(lines), "inserted", last + 3

RELOAD_CONN_HELPER = r"""extends SceneTree

func _init() -> void:
    var a: PackedStringArray = OS.get_cmdline_user_args()
    var res := {"found": false, "connections": []}
    var packed: PackedScene = load(a[1])
    if packed != null:
        var root: Node = packed.instantiate()
        var n: Node = root.get_node_or_null("%" + a[2])
        if n != null:
            res["found"] = true
            for c in n.get_signal_connection_list(a[3]):
                var cb: Callable = c["callable"]
                res["connections"].append([str(cb.get_method()), cb.get_object() == n])
        root.free()
    var f := FileAccess.open(a[0], FileAccess.WRITE)
    f.store_string(JSON.stringify(res))
    f.close()
    quit()
"""

def reload_check_connection(godot, project, host, block):
    tmp = tempfile.mkdtemp(prefix="cascade_reload_")
    helper, out = os.path.join(tmp, "reload.gd"), os.path.join(tmp, "out.json")
    open(helper, "w").write(RELOAD_CONN_HELPER)
    try:
        r = subprocess.run([godot, "--headless", "--path", project, "--script", helper, "--", out, host["owner_scene"], host["name"].lstrip("%"), block["signal"]],
                           capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        die(f"Godot not found as '{godot}'. Use --godot /path/to/godot or: export GODOT=/path/to/godot")
    except subprocess.TimeoutExpired:
        return False, None, "reload timeout (60 s)"
    if not os.path.exists(out): return False, None, "Godot could not reload the scene:\n" + strip_ansi(r.stdout + r.stderr)[-400:]
    res = json.load(open(out))
    if not res.get("found"): return False, None, f"{host['name']} was not found in {host['owner_scene']} after the edit"
    got = res["connections"]; ok = any(m == block["method"] and mine for m, mine in got)
    return ok, got, "" if ok else f"the scene loaded but {host['name']}.{block['signal']} is not connected to {block['method']} (connections: {got})"

def apply_scene_connection(godot, project, host, block):
    """Add one [connection] line to the owner scene: .bak backup first, headless reload check after, rollback if the connection is not there."""
    fp = os.path.join(project, host["owner_scene"][len("res://"):])
    if not os.path.exists(fp): raise ApplyError(f"{host['owner_scene']} not found")
    line = connection_line(block, host)
    new_text, action, line_no = edit_scene_connection(open(fp, "rb").read().decode("utf-8"), line)
    bak = f"{fp}.{block['frame_id']}.{time.strftime('%Y%m%d-%H%M%S')}.bak"
    shutil.copy2(fp, bak)
    tmp = fp + ".cascade_tmp"
    open(tmp, "wb").write(new_text.encode("utf-8")); os.replace(tmp, fp)
    ok, got, msg = reload_check_connection(godot, project, host, block)
    result = {"file": host["owner_scene"], "backup": bak, "action": action, "line": line_no, "before": None, "after": line, "reloaded_value": got, "verified": ok}
    if not ok:
        shutil.copy2(bak, fp); result["rolled_back"] = True; result["problem"] = msg
    return result

def apply_scene(godot, project, host, block):
    if block["op"] == "connect_signal":
        res = apply_scene_connection(godot, project, host, block); res["what"] = f"{host['name']}.{block['signal']} -> {block['method']}"
    elif block["op"] == "add_method":
        res = apply_script_function(godot, project, host, block); res["what"] = f"{host['name']}.{block['fn']}()"
    else:
        res = apply_scene_property(godot, project, host, block); res["what"] = f"{host['name']}.{block['property']}"
    return res

# ---------------------------------------------------------------- add_method (Step 8): one function appended to the host's script
def signature(block): return f"func {block['fn']}({', '.join(block['args'])}) -> {block['returns']}:"

def body_line(block):
    if block["body"] == "pass": return "pass"
    if block["body"] == "assign":
        op = block.get("operator", "=")
        return f"{block['property']} {op} {scene_literal(operand_type(block['type'], op), block['value'])}"
    return f'print("{block["message"]}")'

def script_path(project, host): return os.path.join(project, host["script"][len("res://"):])

def detect_indent(raw):
    """The script's own indent: tabs or the first indented line's spaces; 4 spaces if it has none."""
    for l in raw.splitlines():
        if l.strip() and l[:1] in (" ", "\t"):
            lead = l[:len(l) - len(l.lstrip())]
            return "\t" if "\t" in lead else " " * len(lead)
    return "    "

def canonical_function(block, indent): return f"{signature(block)}\n{indent}{body_line(block)}\n"

def drop_class_name(raw): return "\n".join(l for l in raw.split("\n") if not l.startswith("class_name "))

def append_function_text(raw, func_text):
    nl = "\r\n" if "\r\n" in raw else "\n"
    return raw.rstrip("\r\n") + nl + nl + func_text.replace("\n", nl)

def existing_function(raw, fn):
    """The function's lines (trimmed) if the script defines it at the top level, else None."""
    lines = raw.splitlines()
    for i, l in enumerate(lines):
        if re.match(rf"^func\s+{re.escape(fn)}\s*\(", l):
            body = [l.strip()]
            for m in lines[i + 1:]:
                if m.strip() and m[:1] not in (" ", "\t"): break
                body.append(m.strip())
            while body and not body[-1]: body.pop()
            return body
    return None

def _norm(lines): return [re.sub(r"^self\.", "", x.replace("'", '"')) for x in lines]

def function_matches(project, host, block):
    fp = script_path(project, host)
    if not os.path.exists(fp): return False
    have = existing_function(open(fp, encoding="utf-8").read(), block["fn"])
    return have is not None and _norm(have) == _norm([signature(block), body_line(block)])

def add_method_checks(block, host, spec, project):
    bad, s = [], spec["slots"]
    for k in ("fn", "message"):
        if not re.match(s[k]["rx"], str(block[k])): bad.append(f"block.{k} '{block[k]}' does not match the spec")
    if block["returns"] not in s["returns"]["enum"]: bad.append(f"block.returns '{block['returns']}' not allowed (v1: void)")
    if block["body"] not in s["body"]["enum"]: bad.append(f"block.body '{block['body']}' not allowed (pass or print)")
    args = block["args"]
    if not isinstance(args, list) or len(args) > s["args"]["max_items"] or any(not isinstance(x, str) or not re.match(s["args"]["item_rx"], x) for x in args):
        bad.append("block.args must be a list of at most 3 'name: Type' strings (Type: bool, int, float, String, Vector2, Vector3, Color)")
    elif len({x.split(":")[0] for x in args}) != len(args): bad.append("block.args repeats an argument name")
    if block["body"] == "pass" and block["message"] != "": bad.append("block.message must be empty when body is pass")
    if block["body"] == "print" and block["message"] == "": bad.append("block.message must not be empty when body is print")
    if block["body"] == "assign":
        if block["message"] != "": bad.append("block.message must be empty when body is assign")
        miss = [k for k in ("property", "type", "value") if k not in block]
        if miss: bad.append("block." + ", block.".join(miss) + " must be given when body is assign")
        elif block["property"] not in host.get("props", {}): bad.append(f"block.property '{block['property']}' is not a registered property of {host['name']} (registered: {', '.join(sorted(host.get('props', {}))) or 'none'})")
        elif block["type"] != host["props"][block["property"]]: bad.append(f"block.type {block['type']} but the record says {block['property']} is {host['props'][block['property']]}")
        elif block.get("operator", "=") not in spec["slots"]["operator"]["enum"]: bad.append(f"block.operator '{block.get('operator')}' not allowed (one of {', '.join(spec['slots']['operator']['enum'])})")
        elif block.get("operator", "=") != "=" and block["type"] not in RELATIVE_TYPES: bad.append(f"block.operator {block['operator']} works on {', '.join(RELATIVE_TYPES)} properties, but {block['property']} is {block['type']}")
        elif not value_ok(operand_type(block["type"], block.get("operator", "=")), block["value"]): bad.append(f"block.value {block['value']} is not a valid {operand_type(block['type'], block.get('operator', '='))} operand for {block.get('operator', '=')} on {block['property']}")
        elif block.get("operator", "=") != "=" and is_identity(block["operator"], block["type"], block["value"]): bad.append(f"block.value {block['value']} with {block['operator']} changes nothing; a handler that does nothing is not what was asked for")
        elif block.get("operator", "=") == "=" and block["type"] == "String" and not re.match(spec["slots"]["message"]["rx"], str(block["value"])): bad.append("block.value for a String must use the plain message charset (letters, digits, space and _ . , : ! ? -), so the mule can type it safely")
    else:
        extra = [k for k in ("property", "type", "value", "operator") if k in block]
        if extra: bad.append("block." + ", block.".join(extra) + " only belong to body assign")
    if bad: return bad
    if not host.get("script"): return [f"GI_1 script: {host['name']} has no script, so it cannot get a method (adding a script is an open slot)"]
    fp = script_path(project, host)
    if not os.path.exists(fp): return [f"GI_1 script: {host['script']} not found"]
    for k in ("signals", "methods", "props"):
        if k not in host: bad.append(f"GI_1 registry has no '{k}' field; update and re-run registry_builder.py")
    if bad: return bad
    if block["fn"] in host["signals"]: bad.append(f"GI_1 fn: '{block['fn']}' is a signal of {host['name']}")
    if block["fn"] in host["props"]: bad.append(f"GI_1 fn: '{block['fn']}' is a property of {host['name']} (Godot would accept it, and it would shadow the property)")
    have = existing_function(open(fp, encoding="utf-8").read(), block["fn"])
    if have is not None and _norm(have) != _norm([signature(block), body_line(block)]):
        bad.append(f"GI_1 fn_exists: {block['fn']} is already defined in {host['script']} with a different body; editing a function is an open slot")
    return bad

def add_method_stmt_error(stmt, block):
    lines = stmt.split("\n")
    if len(lines) != 2: return f"type_match: stmt must be exactly two lines (the signature and one indented body line), got {len(lines)}"
    if lines[0] != signature(block): return f"type_match: line 1 must be {signature(block)}"
    if lines[1][:1] not in (" ", "\t"): return "type_match: the body line must be indented"
    want = body_line(block)
    if block["body"] == "assign":
        op, prop, s1 = block.get("operator", "="), re.escape(block["property"]), lines[1].strip()
        ot = operand_type(block["type"], op)
        if op == "=": m = re.match(rf"^(?:self\.)?{prop}\s*=\s*(.+)$", s1)
        else: m = re.match(rf"^(?:self\.)?{prop}\s*{re.escape(op)}\s*(.+)$", s1) or re.match(rf"^(?:self\.)?{prop}\s*=\s*(?:self\.)?{prop}\s*{re.escape(op[0])}\s*(.+)$", s1)
        if not m: return f"type_match: the body must be one statement on {block['property']}: {want} (self. before the property is also accepted" + (f", and the long form {block['property']} = {block['property']} {op[0]} operand" if op != "=" else "") + ")"
        expr = m.group(1).strip()
        if block["type"] == "String" and re.match(r"^'[^'\\\"]*'$", expr): expr = '"' + expr[1:-1] + '"'     # single quotes are the same string; the harness writes double quotes
        err = expr_error(ot, expr, block["value"])
        return ("type_match: " + err) if err else None
    if lines[1].strip() not in (want, want.replace('"', "'")): return f"type_match: the body must be {want} (single quotes are also accepted)"
    return None

def judge_function(godot, project, host, block):
    """Slot 4 for add_method: the canonical function appended to a temporary copy of the whole script, then godot --check-only."""
    raw = open(script_path(project, host), "rb").read().decode("utf-8")
    text = append_function_text(drop_class_name(raw), canonical_function(block, detect_indent(raw)))
    path = os.path.join(tempfile.mkdtemp(prefix="cascade_judge_"), "frame.gd")
    open(path, "w", encoding="utf-8", newline="").write(text)
    try:
        r = subprocess.run([godot, "--headless", "--path", project, "--check-only", "--script", path], capture_output=True, text=True, timeout=60)
    except FileNotFoundError:
        die(f"Godot not found as '{godot}'. Use --godot /path/to/godot or: export GODOT=/path/to/godot")
    except subprocess.TimeoutExpired:
        return False, "judge timeout (60 s)"
    if r.returncode == 0: return True, ""
    lines = strip_ansi(r.stdout + r.stderr).splitlines(); errs = []
    for i, l in enumerate(lines):
        if l.startswith("SCRIPT ERROR:"):
            at = lines[i + 1].strip() if i + 1 < len(lines) and lines[i + 1].strip().startswith("at:") else ""
            errs.append((l[len("SCRIPT ERROR:"):].strip() + " " + at.replace(path, "frame.gd")).strip())
    return False, " | ".join(errs[:3]) or "\n".join(lines[-4:])

def godot_errors(text):
    return " | ".join(l[len("SCRIPT ERROR:"):].strip() for l in strip_ansi(text).splitlines() if l.startswith("SCRIPT ERROR:"))[:300]

def judge_op(godot, project, host, block, stmt):
    if block["op"] == "add_method": return judge_function(godot, project, host, block)
    return judge(godot, project, host, canonical_stmt(stmt, block))

