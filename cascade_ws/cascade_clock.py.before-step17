    res = json.load(open(out))
    if not res.get("found"): return False, res, f"{host['name']} was not found in {host['owner_scene']} after the edit"
    if not res["can_instantiate"]: return False, res, f"the script no longer compiles ({host['script']}): " + (godot_errors(r.stdout + r.stderr) or strip_ansi(r.stdout + r.stderr)[-300:].strip())
    if not res["has_method"]: return False, res, f"{host['name']} does not have {block['fn']}() after the edit"
    if res["arg_count"] != len(block["args"]): return False, res, f"{block['fn']}() has {res['arg_count']} arguments, expected {len(block['args'])}"
    return True, res, ""

def apply_script_function(godot, project, host, block):
    """Append the canonical function to the host's script: .bak backup first, headless reload check after, rollback if it fails."""
    fp = script_path(project, host)
    if not os.path.exists(fp): raise ApplyError(f"{host['script']} not found")
    raw = open(fp, "rb").read().decode("utf-8")
    func_text = canonical_function(block, detect_indent(raw))
    new_text = append_function_text(raw, func_text)
    line_no = max(i for i, l in enumerate(new_text.splitlines()) if l.startswith(f"func {block['fn']}(")) + 1
    bak = f"{fp}.{block['frame_id']}.{time.strftime('%Y%m%d-%H%M%S')}.bak"
    shutil.copy2(fp, bak)
    tmp = fp + ".cascade_tmp"
    open(tmp, "wb").write(new_text.encode("utf-8")); os.replace(tmp, fp)
    ok, got, msg = reload_check_function(godot, project, host, block)
    result = {"file": host["script"], "backup": bak, "action": "appended", "line": line_no, "before": None,
              "after": f"{signature(block)}  {body_line(block)}", "reloaded_value": got, "verified": ok}
    if not ok:
        shutil.copy2(bak, fp); result["rolled_back"] = True; result["problem"] = msg
    return result

def refresh_registry(ws, godot, host, block):
    """After a function was added the registry is stale: re-run the builder, then confirm the new function is listed."""
    try:
        r = subprocess.run([sys.executable, os.path.join(ws, "registry_builder.py"), "--ws", ws, "--godot", godot], capture_output=True, text=True, timeout=300)
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        return {"ok": False, "detail": f"{type(e).__name__}: {e}"}
    if r.returncode != 0: return {"ok": False, "detail": strip_ansi(r.stdout + r.stderr)[-300:].strip()}
    h = json.load(open(os.path.join(ws, "state_registry.json")))["hosts"].get(host["addr"]) or {}
    return {"ok": True, "listed": block["fn"] in h.get("methods", []), "methods": len(h.get("methods", []))}

# ---------------------------------------------------------------- Step 9: Slot 5 VERIFY (behavior probe), chain, process-start GI_2
CLOCK_OPS = ("modify_property", "connect_signal", "add_method")

def model_loaded(model):
    b = sys.modules.get("bench")
    return bool(b is not None and getattr(b, "_loaded", {}).get("key") == model)

PROBE_GD = r"""extends SceneTree
# behavior probe. args: out, scene, node name, mode (signal|call), name, method, props (json), argument types (json)
var spy := 0

func _count(_s: String) -> void:
    spy += 1

func _j(v: Variant) -> Variant:
    match typeof(v):
        TYPE_VECTOR2:
            return [v.x, v.y]
        TYPE_VECTOR3:
            return [v.x, v.y, v.z]
        TYPE_COLOR:
            return [v.r, v.g, v.b, v.a]
    return v

func _from_j(t: String, v: Variant) -> Variant:
    match t:
        "int":
            return int(v)
        "Vector2":
            return Vector2(v[0], v[1])
        "Vector3":
            return Vector3(v[0], v[1], v[2])
        "Color":
            return Color(v[0], v[1], v[2], v[3])
    return v

func _snap(n: Node, props: Array) -> Dictionary:
    var d := {}
    for k in props:
        d[k] = _j(n.get(k))
    return d

func _dummy(t: String) -> Variant:
    match t:
        "bool":
            return false
        "int":
            return 0
        "float":
            return 0.0
        "String":
            return ""
        "Vector2":
            return Vector2.ZERO
        "Vector3":
            return Vector3.ZERO
        "Color":
            return Color.BLACK
    return null

func _run(label: String, a: PackedStringArray, props: Array, types: Array, stimulus: bool) -> Dictionary:
    var mode: String = a[3]
    var nm: String = a[4]
    var main: Node = load(a[1]).instantiate()
    var p: Node = main.get_node("%" + a[2])
    var args: Array = []
    for t in types:
        args.append(_dummy(str(t)))
    spy = 0
    if a.size() > 9 and a[9] == "1":
        p.set_process(false)
        p.set_physics_process(false)
        for sg in p.get_signal_list():
            for cn in p.get_signal_connection_list(str(sg["name"])):
                var cb2: Callable = cn["callable"]
                if cb2.get_object() == p and str(cb2.get_method()).begins_with("_on_") and not (mode == "signal" and str(sg["name"]) == nm and str(cb2.get_method()) == a[5]):
                    p.disconnect(str(sg["name"]), cb2)
    if a.size() > 8:
        var pt: Variant = JSON.parse_string(a[8])
        if pt != null:
            p.set(str(pt["prop"]), _from_j(str(pt["type"]), pt["value"]))
    if mode == "signal":
        var cb: Callable = Callable(self, "_count").bind(nm)
        p.connect(nm, cb.unbind(types.size()) if types.size() > 0 else cb)
        if not stimulus:
            var h: Callable = Callable(p, a[5])
            if p.is_connected(nm, h):
                p.disconnect(nm, h)
    var res := {"label": label, "pre": _snap(p, props), "explicit": false, "natural_emissions": 0}
    print("VERIFY>> ", label)
    root.add_child(main)
    await process_frame
    if mode == "call":
        if stimulus:
            p.callv(nm, args)
    else:
        root.remove_child(main)
        await process_frame
        res["natural_emissions"] = spy
        if spy == 0:
            res["explicit"] = true
            root.add_child(main)
            await process_frame
            p.callv("emit_signal", [nm] + args)
            root.remove_child(main)
            await process_frame
    res["emissions"] = spy
    res["post"] = _snap(p, props)
    print("VERIFY<< ", label)
    main.free()
    return res

func _initialize() -> void:
    var a: PackedStringArray = OS.get_cmdline_user_args()
    var props: Array = JSON.parse_string(a[6])
    var types: Array = JSON.parse_string(a[7])
    var normal: Dictionary = await _run("normal", a, props, types, true)
    var control: Dictionary = await _run("control", a, props, types, false)
    var f := FileAccess.open(a[0], FileAccess.WRITE)
