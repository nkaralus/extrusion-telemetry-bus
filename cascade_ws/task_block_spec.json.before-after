{
  "spec": "task_block",
  "version": 1,
  "engine": "godot4",
  "who_sees": "mule",
  "language": "none",
  "slots": {
    "frame_id": {
      "type": "string",
      "rx": "^0x[0-9A-F]{4}$"
    },
    "time_slot": {
      "type": "string",
      "enum": [
        "SLOT_3_EXECUTE"
      ]
    },
    "subnet": {
      "type": "string",
      "rx": "^10\\.\\d{1,3}\\.\\d{1,3}\\.0/(16|24)$"
    },
    "op": {
      "type": "string",
      "enum": [
        "spawn_instance",
        "modify_property",
        "connect_signal",
        "add_method"
      ]
    },
    "target": {
      "type": "string",
      "rx": "^%[A-Za-z_][A-Za-z0-9_]*$",
      "enum_from": "state_registry.names_in_subnet"
    },
    "property": {
      "type": "string",
      "enum_from": "rag_record.props"
    },
    "type": {
      "type": "string",
      "enum": [
        "bool",
        "int",
        "float",
        "String",
        "Vector2",
        "Vector3",
        "Color"
      ],
      "must_equal": "rag_record.props[property]"
    },
    "value": {
      "type": "by_type",
      "vector2": [
        0.0,
        0.0
      ],
      "vector3": [
        0.0,
        0.0,
        0.0
      ],
      "color": [
        0.0,
        0.0,
        0.0,
        1.0
      ]
    },
    "ref": {
      "type": "string",
      "rx": "^10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$",
      "must_equal": "rag_record.addr"
    },
    "exclude": {
      "type": "array",
      "items": "string",
      "enum": [
        "KinematicBody2D",
        "Spatial",
        "yield",
        "onready_var",
        "export_var",
        "setget",
        "connect_3arg",
        "instance_call",
        "rand_range",
        "move_and_slide_args",
        "OS_ticks",
        "File_Directory",
        "Pool_arrays",
        "untyped_variables",
        "relative_paths_up_tree",
        "cross_subnet_queries"
      ],
      "min_items": 1
    },
    "source": {
      "type": "string",
      "rx": "^%[A-Za-z_][A-Za-z0-9_]*$",
      "enum_from": "state_registry.names_in_subnet"
    },
    "signal": {
      "type": "string",
      "rx": "^[A-Za-z_][A-Za-z0-9_]*$",
      "enum_from": "rag_record.signals"
    },
    "method": {
      "type": "string",
      "rx": "^_on_[a-z0-9_]+$",
      "enum_from": "rag_record.methods",
      "must_equal": "_on_<snake(target)>_<signal>"
    },
    "fn": {
      "type": "string",
      "rx": "^[a-z_][a-z0-9_]{0,39}$"
    },
    "args": {
      "type": "array",
      "items": "string",
      "max_items": 3,
      "item_rx": "^[a-z_][a-z0-9_]*: (bool|int|float|String|Vector2|Vector3|Color)$"
    },
    "returns": {
      "type": "string",
      "enum": [
        "void"
      ]
    },
    "body": {
      "type": "string",
      "enum": [
        "pass",
        "print",
        "assign"
      ],
      "also_array": "body may be an array of 1 to 6 statement objects: {kind: assign|relative|print|pass, ...}; with an array, message must be empty and property/type/operator/value live inside the statements"
    },
    "message": {
      "type": "string",
      "rx": "^[A-Za-z0-9 _.,:!?-]{0,40}$"
    },
    "operator": {
      "type": "string",
      "enum": [
        "=",
        "+=",
        "-=",
        "*="
      ],
      "default": "="
    },
    "mode": {
      "type": "string",
      "enum": [
        "add",
        "replace"
      ],
      "default": "add"
    },
    "statement": {
      "kinds": {
        "assign": [
          "property",
          "type",
          "value"
        ],
        "relative": [
          "property",
          "type",
          "operator",
          "value"
        ],
        "print": [
          "message"
        ],
        "pass": []
      },
      "max_statements": 6,
      "rules": [
        "pass only alone",
        "one = per property",
        "the net effect on every touched property must differ from its start",
        "a relative statement may not be overwritten by a later ="
      ]
    }
  },
  "ops": {
    "modify_property": {
      "status": "locked",
      "slots": [
        "frame_id",
        "time_slot",
        "subnet",
        "op",
        "target",
        "property",
        "type",
        "value",
        "ref",
        "exclude"
      ]
    },
    "spawn_instance": {
      "status": "open"
    },
    "connect_signal": {
      "status": "locked",
      "slots": [
        "frame_id",
        "time_slot",
        "subnet",
        "op",
        "source",
        "target",
        "signal",
        "method",
        "ref",
        "exclude"
      ],
      "v1": "source must equal target; the method is _on_<node>_<signal> and must already exist in the node's script; the harness writes the [connection] line, the mule only types the method name",
      "v2": "source may differ from target: the signal is emitted by source, the handler lives on target (ref is the target's address). Both must be registry hosts in the same scene and the same subnet; the method is _on_<source>_<signal> and must already exist on the target; the harness writes [connection signal from=<source> to=<target> method]; the mule only completes the method name after %<source>.<signal>.connect(",
      "cross_node": true
    },
    "add_method": {
      "status": "locked",
      "slots": [
        "frame_id",
        "time_slot",
        "subnet",
        "op",
        "target",
        "fn",
        "args",
        "returns",
        "body",
        "message",
        "ref",
        "exclude"
      ],
      "v1": "append one function with a one-line body (pass or print) to the host node's script; the harness writes the canonical text, the mule only completes the body line",
      "optional_slots": [
        "property",
        "type",
        "value",
        "operator",
        "mode"
      ],
      "v2": "body may also be assign: <property> = <literal> for a registered property; property, type and value are then required, and forbidden for pass and print",
      "v3": "with body assign, operator may be = (default), +=, -= or *=; value is then the operand (float or int for numbers, the same vector for + -, a float for vector *)",
      "v4": "mode replace swaps the whole body of an existing _on_ handler without arguments (same signature); it needs an array body"
    }
  },
  "reply": {
    "status": "added_for_review",
    "slots": {
      "frame_id": "echo",
      "target": "echo",
      "stmt": {
        "type": "string",
        "lines": 1
      }
    }
  },
  "exclude_default": [
    "KinematicBody2D",
    "Spatial",
    "yield",
    "onready_var",
    "export_var",
    "setget",
    "connect_3arg",
    "instance_call",
    "rand_range",
    "move_and_slide_args",
    "OS_ticks",
    "File_Directory",
    "Pool_arrays",
    "untyped_variables",
    "relative_paths_up_tree",
    "cross_subnet_queries"
  ],
  "exclude_checks": {
    "KinematicBody2D": {
      "kind": "regex",
      "rx": "\\bKinematicBody(2D)?\\b"
    },
    "Spatial": {
      "kind": "regex",
      "rx": "\\bSpatial\\b"
    },
    "yield": {
      "kind": "regex",
      "rx": "\\byield\\s*\\("
    },
    "onready_var": {
      "kind": "regex",
      "rx": "(?<!@)\\bonready\\s+var\\b"
    },
    "export_var": {
      "kind": "regex",
      "rx": "(?<!@)\\bexport\\s*(\\(|var\\b)"
    },
    "setget": {
      "kind": "regex",
      "rx": "\\bsetget\\b"
    },
    "connect_3arg": {
      "kind": "regex",
      "rx": "\\.connect\\(\\s*\\\"[^\\\"]+\\\"\\s*,\\s*[^,()]+,\\s*\\\""
    },
    "instance_call": {
      "kind": "regex",
      "rx": "\\.instance\\s*\\("
    },
    "rand_range": {
      "kind": "regex",
      "rx": "\\brand_range\\s*\\("
    },
    "move_and_slide_args": {
      "kind": "regex",
      "rx": "move_and_slide\\(\\s*[^)\\s]"
    },
    "OS_ticks": {
      "kind": "regex",
      "rx": "\\bOS\\.get_ticks_msec\\b"
    },
    "File_Directory": {
      "kind": "regex",
      "rx": "\\b(File|Directory)\\.new\\s*\\("
    },
    "Pool_arrays": {
      "kind": "regex",
      "rx": "\\bPool\\w+Array\\b"
    },
    "untyped_variables": {
      "kind": "regex",
      "rx": "\\bvar\\s+\\w+\\s*(=|$)"
    },
    "relative_paths_up_tree": {
      "kind": "regex",
      "rx": "\\.\\./"
    },
    "cross_subnet_queries": {
      "kind": "code",
      "rule": "target_addr_prefix_must_equal_block_subnet"
    }
  },
  "guards": {
    "GI_1": {
      "checks": [
        "addr_in_registry",
        "uid_in_registry",
        "no_addr_conflict"
      ]
    },
    "GI_2": {
      "vram_gb_max": 10.0,
      "ram_cache_gb_max": 6.0
    },
    "GI_3": {
      "checks": [
        "json_parse",
        "slot_enum_match",
        "type_match",
        "exclude_hit",
        "subnet_boundary"
      ]
    },
    "SLOT_4": {
      "judge": "godot --headless --check-only --script <res_path>",
      "on_pass": "ACK",
      "on_fail": "NAK",
      "max_tries": 3,
      "after_max": "dead_letter_queue",
      "nak_carries": "exact_error"
    }
  }
}